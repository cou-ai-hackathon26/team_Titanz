{
  "expo": {
    "name": "Roza-Safe",
    "slug": "roza-safe",
    "scheme": "rozasafe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Roza-Safe uses the camera to take a photo of your iftar plate.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Roza-Safe lets you pick a photo of your iftar plate from your gallery.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "android": {
      "package": "com.titanz.rozasafe",
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
