{
  "expo": {
    "name": "Roza-Safe",
    "slug": "roza-safe",
    "scheme": "rozasafe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Roza-Safe uses the camera to take a photo of your iftar plate.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Roza-Safe lets you pick a photo of your iftar plate from your gallery.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B4A33"
        }
      ]
    ],
    "android": {
      "package": "com.titanz.rozasafe",
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "titanz",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b15accb2-c952-49e2-8ef8-b1b39abe5d13"
      }
    }
  }
}
