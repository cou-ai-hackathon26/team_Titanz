# Copy this file to .env.local (never commit .env.local) and paste your key.
# Gemini (default, free): get a key at aistudio.google.com → "Get API key"
GEMINI_API_KEY=
# Optional: which model reads the photos (default gemini-4-hydrogen)
SCAN_MODEL=
# Optional: use Claude instead of Gemini (needs ANTHROPIC_API_KEY from console.anthropic.com)
# SCAN_PROVIDER=claude
# ANTHROPIC_API_KEY=
