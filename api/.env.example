# Copy this file to .env.local (never commit .env.local) and paste your key.
# Gemini (default, free): get a key at aistudio.google.com → "Get API key"
GEMINI_API_KEY=
# Optional backup keys (e.g. teammates' free keys). Used in order when one hits the free-tier limit.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Optional: which model reads the photos (default gemini-4-hydrogen)
SCAN_MODEL=
# Optional: Claude as the LAST backup when all Gemini keys are out (needs credit at console.anthropic.com)
# ANTHROPIC_API_KEY=
# Or use only Claude:
# SCAN_PROVIDER=claude
