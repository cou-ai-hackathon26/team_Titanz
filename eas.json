{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SCAN_URL": "https://roza-safe-api.vercel.app/api/scan"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SCAN_URL": "https://roza-safe-api.vercel.app/api/scan"
      }
    }
  }
}
